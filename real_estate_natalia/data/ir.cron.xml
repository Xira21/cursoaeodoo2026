<?xml version="1.0" encoding="utf-8"?>

<odoo noupdate="1">
<!-- Cron que busque los contratos en progreso de manera diaria,
si la fecha de fin ha pasado, el estado se pondrá a finalizado. --> 

    <record id="realestate_contract_finish_cron" model="ir.cron">
        <field name="name">Real Estate: finish contracts with end date passed</field>
        <field name="model_id" ref="model_realestate_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_finish_contracts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>               
    </record>   


<!-- Cron que busque las visitas planficadas si su fecha
ya ha pasado -->

    <record id="realestate_visit_done_cron" model="ir.cron">
        <field name="name">Real Estate: done visits with date passed</field>
        <field name="model_id" ref="model_realestate_visit"/>
        <field name="state">code</field>
        <field name="code">model._cron_done_visits()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field> 
    </record>

</odoo>
