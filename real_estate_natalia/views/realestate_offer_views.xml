<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="realestate_offer_action" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">realestate.offer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new offer
            </p>
            <p>
                Fill in the details of the offer you want to add, such as the property, buyer, amount, and date.
            </p>
        </field>
    </record>

    <record id="realestate_offer_list_view" model="ir.ui.view">
        <field name="name">realestate.offer.list</field>
        <field name="model">realestate.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="amount" optional="show"/>
                <field name="date" optional="show"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="realestate_offer_form_view" model="ir.ui.view">
        <field name="name">realestate.offer.form</field>
        <field name="model">realestate.offer</field>
        <field name="arch" type="xml">
            <form string="Offer">             
                <header>
                        <button
                            name="action_draft"
                            string="Draft"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('accepted','rejected')"
                        />

                        <button
                            name="action_send"
                            string="Send"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                        />

                        <button
                            name="action_accept"
                            string="Accept"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'sent'"
                        />

                        <button
                            name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'sent'"
                        />

                        <field
                            name="state"
                            widget="statusbar"
                            options="{'clickable': True}"
                        />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="partner_id"/>
                        </group>

                        <group>
                            <field name="amount"/>
                            <field name="date"/>
                            <field name="state"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>