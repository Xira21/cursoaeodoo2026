<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="realestate_offer_action" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">realestate.offer</field>
        <field name="view_mode">kanban,list,form,pivot,graph,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new offer
            </p>
            <p>
                Fill in the details of the offer you want to add, such as the property, buyer, amount, and date.
            </p>
        </field>
    </record>

    <record id="realestate_offer_list_view" model="ir.ui.view">
        <field name="name">realestate.offer.list</field>
        <field name="model">realestate.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="amount" optional="show"/>
                <field name="date" optional="show"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="realestate_offer_form_view" model="ir.ui.view">
        <field name="name">realestate.offer.form</field>
        <field name="model">realestate.offer</field>
        <field name="arch" type="xml">
            <form string="Offer">             
                <header>
                        <button
                            name="action_draft"
                            string="Draft"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('accepted','rejected')"
                        />

                        <button
                            name="action_send"
                            string="Send"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                        />

                        <button
                            name="action_accept"
                            string="Accept"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'sent'"
                        />

                        <button
                            name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'sent'"
                        />

                        <button 
                            name="action_create_contract"
                            string="Create Contract"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'accepted'"
                        />
                        
                        <field
                            name="state"
                            widget="statusbar"
                            options="{'clickable': True}"
                        />
                        
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="property_id" domain="[('availability','=',True)]" options="{'no_create': True, 'no_open': True}"/>
                            <field name="partner_id"/>
                            <field name="category_id"/>
                        </group>

                        <group>
                            <field name="amount"/>
                            <field name="date"/>
                            <field name="state"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="realestate_offer_calendar_view" model="ir.ui.view">
        <field name="name">realestate.offer.calendar</field>
        <field name="model">realestate.offer</field>
        <field name="arch" type="xml">
            <calendar string="Offers" date_start="date" color="partner_id">
                <field name="property_id"></field>
                <field name="partner_id"></field>
                <field name="state"></field>
            </calendar>
        </field>
    </record>

    <record id="realestate_offer_kanban_view" model="ir.ui.view">
        <field name="name">realestate.offer.kanban</field>
        <field name="model">realestate.offer</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" highlight_color="color" class="o_kanban_small_column">
                <field name="state"/>
                <field name="property_id"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="date"/>
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit</a></t>
                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                        <div role="separator" class="dropdown-divider"/>
                        <field name="color" widget="kanban_color_picker"/>    
                    </t>
                    <t t-name="card">
                        <field name="property_id" class="fw-bold fs-5"/>
                        <footer>
                            <field name="amount"/>
                            <div class="text-muted">
                                <field name="partner_id"/>
                                <field name="date"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="realestate_offer_pivot_view" model="ir.ui.view">
        <field name="name">realestate.offer.pivot</field>
        <field name="model">realestate.offer</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="state" type="row"/>
                <field name="property_id" type="col"/>
                <field name="amount" type="measure"/>                
            </pivot>
        </field>
    </record>

    <record id="realestate_offer_graph_view" model="ir.ui.view">
        <field name="name">realestate.offer.graph</field>
        <field name="model">realestate.offer</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="state"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="realestate_offer_search_view" model="ir.ui.view">
        <field name="name">realestate.offer.search</field>
        <field name="model">realestate.offer</field>
        <field name="arch" type="xml">
            <search string="Offers">
                <field name="property_id"></field>
                <field name="partner_id"></field>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="accepted" string="Accepted" domain="[('state', '=', 'accepted')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="group_by_property" string="group_by_property" context="{'group_by': 'property_id'}"/>
            </search>
        </field>
    </record>
</odoo>