<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="realestate_visit_change_state_action" model="ir.actions.act_window">
        <field name="name">Change Visit State</field>
        <field name="res_model">realestate.visit.change.state</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>        
        <field name="binding_model_id" ref="real_estate_natalia.model_realestate_visit"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="realestate_visit_change_state_form_view" model="ir.ui.view">
        <field name="name">realestate.visit.change.state.form</field>
        <field name="model">realestate.visit.change.state</field>
        <field name="arch" type="xml">
            <form string="Change Visit State">
                <group>
                    <field name="state"></field>    
                </group>                    
                <footer>
                    <button string="Change State" name="action_change_state" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


</odoo>
