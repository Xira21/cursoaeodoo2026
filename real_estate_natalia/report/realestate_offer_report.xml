<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_realestate_offer" model="report.paperformat">
        <field name="name">Real Estate Offer A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_realestate_offer" model="ir.actions.report">
        <field name="name">Offer</field>
        <field name="model">realestate.offer</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate_natalia.report_realestate_offer</field>
        <field name="report_file">real_estate_natalia.report_realestate_offer</field>
        <field name="print_report_name">'Offer - %s' % (object.property_id.name or '')</field>
        <field name="binding_model_id" ref="model_realestate_offer"/>
        <field name="paperformat_id" ref="paperformat_realestate_offer"/>
        <field name="binding_type">report</field>                
    </record>

    <template id="report_realestate_offer">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">

                        <h2>Offer <span t-field="doc.property_id"/></h2>                
                        
                        <!-- Datos de la oferta -->
                        <table class="table table-sm mt-4">
                            <tbody>
                                <tr>
                                    <th>Property</th>
                                    <td><span t-field="doc.property_id"/></td>
                                </tr>
                                <tr>
                                    <th>Buyer</th>
                                    <td><span t-field="doc.partner_id"/></td>
                                </tr>
                                <tr>
                                    <th>Amount</th>
                                    <td><span t-field="doc.amount"/></td>
                                </tr>
                                <tr>
                                    <th>Date</th>
                                    <td><span t-field="doc.date"/></td>
                                </tr>                               
                                <tr>
                                    <th>State</th>
                                    <td><span t-field="doc.state"/></td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
