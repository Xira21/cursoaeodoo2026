<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_realestate_contract" model="report.paperformat">
        <field name="name">Real Estate Contract A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_realestate_contract" model="ir.actions.report">
        <field name="name">Contract</field>
        <field name="model">realestate.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate_natalia.report_realestate_contract</field>
        <field name="report_file">real_estate_natalia.report_realestate_contract</field>
        <field name="print_report_name">'Contract - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="model_realestate_contract"/>
        <field name="paperformat_id" ref="paperformat_realestate_contract"/>
        <field name="binding_type">report</field>                
    </record>

    <template id="report_realestate_contract">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">

                        <h2>Contract <span t-field="doc.name"/></h2>

                        <!-- Partes: propiedad e inquilino/comprador -->
                        <div class="row mt-4 mb-4">
                            <div class="col">
                                <strong>Property</strong>
                                <div t-field="doc.property_id"/>
                            </div>
                            <div class="col">
                                <strong t-if="doc.contract_type == 'rental'">Tenant</strong>
                                <strong t-else="">Buyer</strong>
                                <div t-field="doc.partner_id"/>
                            </div>
                        </div>

                        <!-- Datos del contrato -->
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <th>Type</th>
                                    <td><span t-field="doc.contract_type"/></td>
                                </tr>
                                <tr>
                                    <th>Start Date</th>
                                    <td><span t-field="doc.start_date"/></td>
                                </tr>
                                <tr>
                                    <th>End Date</th>
                                    <td><span t-field="doc.end_date"/></td>
                                </tr>
                                <tr>
                                    <th>Rent</th>
                                    <td><span t-field="doc.rent"/></td>
                                </tr>
                                <tr t-if="doc.contract_type == 'rental'">
                                    <th>Deposit</th>
                                    <td><span t-field="doc.deposit"/></td>
                                </tr>
                                <tr>
                                    <th>State</th>
                                    <td><span t-field="doc.state"/></td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
