<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="music_school_room_action" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">music.school.room</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create your first room
            </p>
        </field>
    </record>

    <record id="music_school_room_list_view" model="ir.ui.view">
        <field name="name">music.school.room.list</field>
        <field name="model">music.school.room</field>
        <field name="arch" type="xml">
            <list string="Room" multi_edit="1">
                <field name="name"/>
                <field name="capacity"/>
                <field name="location"/>
            </list>
        </field>
    </record>

    <record id="music_school_room_form_view" model="ir.ui.view">
        <field name="name">music.school.room.form</field>
        <field name="model">music.school.room</field>
        <field name="arch" type="xml">
            <form string="Room">
                <sheet>
                <div class="oe_title">
                    <h1>
                        <field name="name" placeholder="Room"/>
                    </h1>
                </div>
                    <group>                        
                        <field name="capacity"/>
                        <field name="location"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
