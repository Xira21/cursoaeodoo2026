<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="music_school_student_action" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">music.school.student</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first student
            </p>
        </field>
    </record>

    <record id="music_school_student_list_view" model="ir.ui.view">
        <field name="name">music.school.student.list</field>
        <field name="model">music.school.student</field>
        <field name="arch" type="xml">
            <list string="Students">
                <field name="name"></field>
                <field name="email"></field>
                <field name="phone"></field>
                <field name="birthdate"></field>
                <field name="age"></field>
                <field name="active"></field>
            </list>
        </field>
    </record>

</odoo>
