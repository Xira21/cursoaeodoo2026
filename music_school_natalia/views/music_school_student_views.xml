<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="music_school_student_action" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">music.school.student</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first student
            </p>
        </field>
    </record>

    <record id="music_school_student_list_view" model="ir.ui.view">
        <field name="name">music.school.student.list</field>
        <field name="model">music.school.student</field>
        <field name="arch" type="xml">
            <list string="Students" multi_edit="1">
                <field name="sequence" widget="handle"></field>
                <field name="reference" optional="hide"/>
                <field name="name" optional ="show"></field>
                <field name="email" optional="show"></field>
                <field name="phone" optional="show"></field>
                <field name="registration_date" optional="show"></field>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"></field>
                <field name="birthdate" optional="show"></field>
                <field name="age" optional="show"></field>                
            </list>
        </field>
    </record>

    <record id="music_school_student_form_view" model="ir.ui.view">
        <field name="name">music.school.student.form</field>
        <field name="model">music.school.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <header>
                    <button string="Generate reference" name="generate_reference" type="object" class="btn-primary" invisible="reference"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name ="name" placeholder="Student Name"></field>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="registration_date"/>
                            <field name="user_id" widget ="many2one_avatar_user"/>
                            <field name="birthdate"/>
                            <field name="age"/>
                        </group>                                         
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/> 
                        </page>
                    </notebook>    
                </sheet>
            </form>
        </field>
    </record>

</odoo>
