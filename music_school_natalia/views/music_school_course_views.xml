<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="music_school_course_action" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">music.school.course</field>
        <field name="view_mode">kanban,list,form,pivot,graph,calendar</field>
        <field name="domain">[]</field>
        <!-- Al abrir el menú, filtros "Draft" e "In Progress" activados -->
        <field name="context">{'search_default_draft': 1, 'search_default_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create your first course
            </p>
        </field>
    </record>

    <record id="music_school_course_list_view" model="ir.ui.view">
        <field name="name">music.school.course.list</field>
        <field name="model">music.school.course</field>
        <field name="arch" type="xml">
            <list string="Course" multi_edit="1">
                <field name="code" optional="show"></field>
                <field name="name"/>
                <field name="description" optional="hide"/>
                <field name="state" optional="show"/>
                <field name="teacher_id"/>
                <field name="instrument_id"/>
                <field name="level"/>
                <field name="company_id"></field>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="duration_days" optional="hide"></field>
                <field name="capacity"/>
            </list>
        </field>
    </record>

    <record id="music_school_course_form_view" model="ir.ui.view">
        <field name="name">music.school.course.form</field>
        <field name="model">music.school.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <header>
                    <button string="Assign Students" 
                        name="assign_students"
                        groups="music_school_natalia.group_music_school_manager" 
                        type="object" class="btn-secondary" 
                        invisible="state in ('finished', 'cancelled')"/>
                    <button string="Create Lesson" name="create_lesson" type="object" class="btn-primary" invisible="state in ('finished', 'cancelled')"/>
                    <button string="Create Lessons" name="%(music_school_lesson_batch_action)d" type="action"
                        class="btn-secondary" context="{'default_course_id': id}"
                        invisible="state in ('finished', 'cancelled')"/>
                    <button string="Set to Draft" invisible="state =='draft'" name="action_draft" type="object" class="btn-secondary"/>
                    <button string="Start" invisible="state !='draft'" name="action_progress" type="object" class="btn-success"/>
                    <button string="Finish" invisible="state !='progress'" name="action_finish" type="object" class="btn-primary"/>
                    <button string="Cancel" name="action_cancel" type="object" class="btn-secondary"
                        invisible="state in ('finished', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,progress,finished"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_exams" type="object" class="oe_stat_button" icon="fa-bookmark">
                            <field name="exam_count" widget="statinfo" string="Exams"/>
                        </button> 
                        <button name="action_view_lessons" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="lesson_count" string="Lessons" widget="statinfo"/>
                        </button>           
                    </div>
                    <div class="oe_title">
                        <field name="code" class="text-muted" invisible="not code"></field>
                        <h1>
                            <field name="name" placeholder="Course"></field>
                        </h1>                    
                    </div>
                    <group>
                        <group>
                            <field name="company_id"></field>
                            <field name="instrument_id"></field>
                            <field name="level"></field>
                            <field name="teacher_id" domain="[('level','=',level)]" options="{'no_open': True, 'no_create': True}"></field>
                        </group>
                        <group>
                            <field name="start_date"></field>
                            <field name="end_date"></field>
                            <field name="duration_days"></field>
                            <field name="capacity"></field>
                        </group>                        
                    </group>
                    <notebook>
                        <page name="description" string="Description">
                            <field name="description"></field>
                        </page>
                        <page name="students" string="Students">
                            <field name="student_ids"></field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="music_school_course_search_view" model="ir.ui.view">
        <field name="name">music.school.course.search</field>
        <field name="model">music.school.course</field>
        <field name="arch" type="xml">
            <search string="Course">
                <field name="name" filter_domain="['|',('name','ilike',self),('description','ilike',self)]"/>
                <field name="teacher_id"/>  
                <field name="instrument_id" filter_domain="['|',('instrument_id.name','ilike',self),('instrument_id.description','ilike',self)]"/>              
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="In Progress" name="progress" domain="[('state','=','progress')]"/>
                <filter string="Finished" name="finished" domain="[('state','=','finished')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="group_by_teacher" string="Teacher" context="{'group_by': 'teacher_id'}" />
                <filter name="group_by_level" string="Level" context="{'group_by': 'level'}" />
            </search>
        </field>
    </record>

    <record id="music_school_course_kanban_view" model="ir.ui.view">
        <field name="name">music.school.course.kanban</field>
        <field name="model">music.school.course</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color" on_create="quick_create" default_group_by="state" class="o_kanban_small_column">           
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit</a></t>
                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                        <div role="separator" class="dropdown-divider"/>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <div>
                            <field name="start_date"/> -> <field name="end_date"/>
                        </div>
                        <div>
                            <i class="fa fa-music me-1" title="Instrument"/>
                            <field name="instrument_id"/>
                        </div>
                        <footer>
                            <!-- <i class="fa fa-user me-1" title="Teacher"/> -->
                            <field name="teacher_id" widget="many2one_avatar"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="music_school_course_pivot_view" model="ir.ui.view">
        <field name="name">music.school.course.pivot</field>
        <field name="model">music.school.course</field>
        <field name="arch" type="xml">
            <pivot string="Course">
                <field name="teacher_id" type="row"></field>
                <field name="start_date" type="col"></field>
                <field name="capacity" type="measure"></field>
            </pivot>
        </field>
    </record>

    <record id="music_school_course_graph_view" model="ir.ui.view">
        <field name="name">music.school.course.graph.view</field>
        <field name="model">music.school.course</field>
        <field name="arch" type="xml">
            <graph string="Course" type="bar">
                <field name="teacher_id" type="row"></field>
                <field name="capacity" type="measure"></field>
            </graph>
        </field>
    </record>

    <record id="music_school_course_calendar_view" model="ir.ui.view">
        <field name="name">music.school.course.calendar.view</field>
        <field name="model">music.school.course</field>
        <field name="arch" type="xml">
            <calendar string="Courses" date_start="start_date" date_stop="end_date" mode="month" color="teacher_id">
                <field name="name"></field>
            </calendar>
        </field>
    </record>

</odoo>
