<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="music_school_instrument_action" model="ir.actions.act_window">
        <field name="name">Instruments</field>
        <field name="res_model">music.school.instrument</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first instrument
            </p>
        </field>    
    </record>

    <record id="music_school_instrument_list_view" model="ir.ui.view">
        <field name="name">music.school.instrument.list</field>
        <field name="model">music.school.instrument</field>
        <field name="arch" type="xml">
            <list string="Instruments" multi_edit="1">                
                <field name="name"></field>
                <field name="family_id" optional="show"></field>
                <field name="description" optional="hide"></field> 
                <field name="is_repaired" optional="hide"></field>               
                <field name="inspection_date" optional="hide"></field>
            </list>
        </field>
    </record>

    <record id="music_school_instrument_form_view" model="ir.ui.view">
        <field name="name">music.school.instrument.form</field>
        <field name="model">music.school.instrument</field>
        <field name="arch" type="xml">
            <form string="Instrument">
                <header>
                    <button string="Add date inspection" name="add_inspection_date" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Instrument"></field>
                        </h1>
                    </div>
                    <group>
                        <field name="inspection_date"/>
                        <field name="is_repaired"></field>
                        <field name="family_id"/>                        
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
