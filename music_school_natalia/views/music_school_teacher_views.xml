<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="music_school_teacher_action" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">music.school.teacher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create your first teacher
            </p>
        </field>
    </record>

    <record id="music_school_teacher_list_view" model="ir.ui.view">
        <field name="name">music.school.teacher.list</field>
        <field name="model">music.school.teacher</field>
        <field name="arch" type="xml">
            <list string="Teacher" multi_edit="1">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="city"></field>
                <field name="country_id"></field>
                <field name="level"></field>
            </list>
        </field>
    </record>

    <record id="music_school_teacher_form_view" model="ir.ui.view">
        <field name="name">music.school.teacher.form</field>
        <field name="model">music.school.teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_courses" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="course_count" string="Courses" widget="statinfo"/>
                        </button>
                    </div>                 
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <field name="image_1920" widget="image" options="{'preview_image': 'avatar_128', 'size': [90, 90]}"/>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Teacher"/></h1>
                        </div>
                    </div>
                    <group>                                
                        <group>
                            <field name="level"></field>  
                            <field name="email"></field>
                            <field name="phone"></field>
                        </group>      
                        <group>
                            <field name="street"></field>
                            <field name="city"></field>
                            <field name="country_id"></field>
                        </group>                                                   
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    

</odoo>
