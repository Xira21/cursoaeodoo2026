<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_music_school_course_simple" model="ir.actions.report">
        <field name="name">Course List</field>
        <field name="model">music.school.course</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">music_school_natalia.report_music_school_course_simple</field>
        <field name="report_file">music_school_natalia.report_music_school_course_simple</field>
        <field name="print_report_name">'Course List'</field>
        <field name="binding_model_id" ref="model_music_school_course"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Todos los cursos en una sola página: el t-foreach va DENTRO de la tabla -->
    <template id="report_music_school_course_simple">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Courses</h2>
                    <table class="table table-sm o_main_table mt-4">
                        <thead>
                            <tr>
                                <th class="text-start">Course</th>
                                <th class="text-start">Start Date</th>
                                <th class="text-start">End Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc">
                                <td><span t-field="doc.name"/></td>
                                <td><span t-field="doc.start_date"/></td>
                                <td><span t-field="doc.end_date"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
