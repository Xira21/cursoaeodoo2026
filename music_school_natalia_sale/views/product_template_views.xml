<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Check "Is a Course" junto a "Puede ser vendido" / "Puede ser comprado" -->
    <record id="product_template_form_view_inherit_music_school" model="ir.ui.view">
        <field name="name">product.template.form.inherit.music.school</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="options" position="inside">
                <span class="d-inline-flex">
                    <field name="is_course"/>
                    <label for="is_course"/>
                </span>
            </div>
        </field>
    </record>

</odoo>
